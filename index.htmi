<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오늘 뭐 먹지? 오늘 저녁 메뉴 추천</title>
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        :root {
            --primary: #FF5E36;
            --primary-hover: #E04822;
            --bg-gradient: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
            --card-bg: rgba(255, 255, 255, 0.95);
            --text-dark: #2C3E50;
            --text-muted: #7F8C8D;
            --shadow: 0 15px 35px rgba(255, 94, 54, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            color: var(--text-dark);
        }

        .container {
            width: 100%;
            max-width: 480px;
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border-radius: 28px;
            padding: 32px 24px;
            box-shadow: var(--shadow);
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.6);
            transition: all 0.3s ease;
        }

        header h1 {
            font-size: 1.8rem;
            font-weight: 800;
            color: #1A1A1A;
            margin-bottom: 8px;
        }

        header p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 24px;
        }

        /* Filter Pills */
        .category-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: center;
            margin-bottom: 28px;
        }

        .cat-btn {
            background: #F1F2F6;
            border: none;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #555;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .cat-btn.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 12px rgba(255, 94, 54, 0.3);
        }

        /* Slots / Emoji Display Area */
        .display-area {
            background: #FFF8F5;
            border: 2px dashed #FFD0C4;
            border-radius: 20px;
            padding: 28px 16px;
            margin-bottom: 28px;
            min-height: 220px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .emoji-box {
            font-size: 5.5rem;
            line-height: 1;
            margin-bottom: 12px;
            user-select: none;
            transition: transform 0.2s ease;
        }

        .emoji-box.bounce {
            animation: bounce 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes bounce {
            0% { transform: scale(0.3); opacity: 0; }
            50% { transform: scale(1.15); }
            70% { transform: scale(0.9); }
            100% { transform: scale(1); opacity: 1; }
        }

        .food-name {
            font-size: 1.6rem;
            font-weight: 800;
            color: #1A1A1A;
            margin-bottom: 6px;
        }

        .food-desc {
            font-size: 0.9rem;
            color: #666;
            word-break: keep-all;
            line-height: 1.4;
            padding: 0 10px;
        }

        .badge {
            display: inline-block;
            background: #FFEBE6;
            color: var(--primary);
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 12px;
            margin-bottom: 10px;
        }

        /* Action Buttons */
        .main-btn {
            width: 100%;
            background: var(--primary);
            color: white;
            border: none;
            padding: 18px 0;
            border-radius: 18px;
            font-size: 1.2rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(255, 94, 54, 0.35);
            transition: all 0.2s ease;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

        .main-btn:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(255, 94, 54, 0.45);
        }

        .main-btn:active {
            transform: translateY(0);
        }

        .main-btn:disabled {
            background: #CCC;
            box-shadow: none;
            cursor: not-allowed;
        }

        .sub-actions {
            margin-top: 16px;
            display: flex;
            gap: 10px;
        }

        .sub-btn {
            flex: 1;
            background: #F1F2F6;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #555;
            cursor: pointer;
            transition: background 0.2s;
        }

        .sub-btn:hover {
            background: #E4E5E9;
        }

        /* Toast Message */
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #333;
            color: #fff;
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 0.85rem;
            opacity: 0;
            transition: all 0.3s ease;
            z-index: 100;
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>오늘 뭐 먹지? 🍽️</h1>
            <p>고민되는 오늘 저녁, 버튼을 눌러 추천받으세요!</p>
        </header>

        <!-- 카테고리 필터 -->
        <div class="category-group">
            <button class="cat-btn active" onclick="setCategory('all', this)">전체</button>
            <button class="cat-btn" onclick="setCategory('korean', this)">한식</button>
            <button class="cat-btn" onclick="setCategory('chinese', this)">중식</button>
            <button class="cat-btn" onclick="setCategory('japanese', this)">일식</button>
            <button class="cat-btn" onclick="setCategory('western', this)">양식</button>
            <button class="cat-btn" onclick="setCategory('snack', this)">분식/야식</button>
        </div>

        <!-- 음식 및 이모지 출력 영역 -->
        <div class="display-area" id="displayArea">
            <div class="badge" id="badge">오늘의 메뉴</div>
            <div class="emoji-box" id="emojiBox">❓</div>
            <div class="food-name" id="foodName">버튼을 눌러주세요</div>
            <div class="food-desc" id="foodDesc">당신만을 위한 맛있는 저녁 메뉴를 정해드립니다!</div>
        </div>

        <!-- 메인 추천 버튼 -->
        <button class="main-btn" id="recommendBtn" onclick="pickMenu()">
            <span>저녁 메뉴 추천 받기</span> 🎲
        </button>

        <div class="sub-actions">
            <button class="sub-btn" onclick="copyResult()">📋 결과 복사하기</button>
        </div>
    </div>

    <div class="toast" id="toast">결과가 클립보드에 복사되었습니다!</div>

    <script>
        const menuData = [
            // 한식
            { name: "김치찌개", emoji: "🥘", desc: "얼큰하고 칼칼한 국물이 생각날 때! 한국인의 영혼의 닭고기 스프.", cat: "korean" },
            { name: "삼겹살", emoji: "🥓", desc: "지글지글 고소한 구이! 지친 하루 끝을 달래줄 완벽한 영양 보충.", cat: "korean" },
            { name: "비빔밥", emoji: "🥣", desc: "각종 신선한 나물과 매콤한 고추장의 조화! 건강하고 든든한 한 끼.", cat: "korean" },
            { name: "제육볶음", emoji: "🥩", desc: "매콤달콤 불향 가득! 밥 한 공기 뚝딱 비우는 최고의 밥도둑.", cat: "korean" },
            { name: "된장찌개", emoji: "🍲", desc: "구수하고 뜨끈한 시골의 맛! 부담 없이 속이 편안해지는 식사.", cat: "korean" },
            
            // 중식
            { name: "짜장면", emoji: "🍜", desc: "달콤짭조름한 춘장 소스의 풍미! 언제 먹어도 호불호 없는 정석.", cat: "chinese" },
            { name: "짬뽕", emoji: "🌶️", desc: "해산물과 불맛이 어우러진 얼큰한 국물! 스트레스 싹 날리는 맛.", cat: "chinese" },
            { name: "탕수육", emoji: "🥩", desc: "바삭하고 달콤한 찍먹 vs 부먹! 식탁을 풍성하게 만드는 주역.", cat: "chinese" },
            { name: "마라탕", emoji: "🍲", desc: "얼얼하고 알싸한 중독성! 내가 좋아하는 재료만 쏙쏙 골라 담기.", cat: "chinese" },

            // 일식
            { name: "초밥", emoji: "🍣", desc: "신선한 회와 밥의 깔끔한 만남! 분위기 있게 즐기는 특별한 저녁.", cat: "japanese" },
            { name: "돈카츠", emoji: "🥩", desc: "겉은 바삭, 속은 촉촉! 고소하고 두툼한 고기 육즙 가득.", cat: "japanese" },
            { name: "라멘", emoji: "🍜", desc: "진하고 깊은 돈코츠 국물 한 입! 일본 현지의 맛 그대로.", cat: "japanese" },
            { name: "카레", emoji: "🍛", desc: "진한 진국 루와 달달한 양파의 풍미! 든든하게 비벼 먹기 좋은 메뉴.", cat: "japanese" },

            // 양식
            { name: "파스타", emoji: "🍝", desc: "고소한 크림 or 상큼한 토마토! 와인 한 잔 곁들이기 좋은 메뉴.", cat: "western" },
            { name: "피자", emoji: "🍕", desc: "쭉 늘어나는 고소한 치즈! 여럿이 함께 즐기기 좋은 저녁 패스트푸드.", cat: "western" },
            { name: "스테이크", emoji: "🥩", desc: "육즙 가득 풍미 작렬! 오늘 하루 고생한 나에게 주는 근사한 선물.", cat: "western" },
            { name: "수제버거", emoji: "🍔", desc: "두툼한 패티와 신선한 야채의 조합! 한 입 가득 풍성한 만족감.", cat: "western" },

            // 분식/야식
            { name: "떡볶이", emoji: "🍢", desc: "매콤달콤 양념과 쫄깃한 떡! 튀김, 순대와 함께라면 극락.", cat: "snack" },
            { name: "치킨", emoji: "🍗", desc: "바삭한 튀김옷과 고소한 속살! 오늘 저녁 시원한 맥주 한 잔과 함께?", cat: "snack" },
            { name: "족발/보쌈", emoji: "🍖", desc: "쫄깃하고 부드러운 고기 한 점! 쟁반국수와 막걸리 꿀조합.", cat: "snack" }
        ];

        let currentCategory = 'all';
        let isSpinning = false;
        let lastSelected = null;

        const slotEmojis = ["🥘", "🥓", "🍜", "🍣", "🍕", "🍔", "🍗", "🍢", "🥩", "🍛", "🌶️"];

        function setCategory(cat, btn) {
            if (isSpinning) return;
            currentCategory = cat;
            
            document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        function pickMenu() {
            if (isSpinning) return;

            const filteredList = currentCategory === 'all' 
                ? menuData 
                : menuData.filter(item => item.cat === currentCategory);

            if (filteredList.length === 0) return;

            isSpinning = true;
            const btn = document.getElementById('recommendBtn');
            const emojiBox = document.getElementById('emojiBox');
            const foodName = document.getElementById('foodName');
            const foodDesc = document.getElementById('foodDesc');
            const badge = document.getElementById('badge');

            btn.disabled = true;
            foodName.innerText = "추천 메뉴 찾는 중...";
            foodDesc.innerText = "오늘 저녁을 책임질 최고의 음식을 골라내고 있습니다!";
            badge.innerText = "랜덤 추출 중";
            
            emojiBox.classList.remove('bounce');

            // 슬롯 애니메이션
            let counter = 0;
            const interval = setInterval(() => {
                emojiBox.innerText = slotEmojis[counter % slotEmojis.length];
                counter++;
            }, 80);

            // 결과 도출 (1.2초 후)
            setTimeout(() => {
                clearInterval(interval);

                // 이전 뽑은 것과 중복 방지 (목록이 2개 이상일 때)
                let selected;
                do {
                    selected = filteredList[Math.floor(Math.random() * filteredList.length)];
                } while (filteredList.length > 1 && lastSelected && selected.name === lastSelected.name);

                lastSelected = selected;

                // 결과 적용
                emojiBox.innerText = selected.emoji;
                foodName.innerText = selected.name;
                foodDesc.innerText = selected.desc;
                badge.innerText = getCategoryName(selected.cat);

                // 애니메이션 효과
                emojiBox.classList.add('bounce');
                
                // 폭죽 효과 (Confetti)
                confetti({
                    particleCount: 50,
                    spread: 60,
                    origin: { y: 0.7 }
                });

                isSpinning = false;
                btn.disabled = false;
            }, 1200);
        }

        function getCategoryName(cat) {
            switch(cat) {
                case 'korean': return '한식';
                case 'chinese': return '중식';
                case 'japanese': return '일식';
                case 'western': return '양식';
                case 'snack': return '분식/야식';
                default: return '오늘의 메뉴';
            }
        }

        function copyResult() {
            const name = document.getElementById('foodName').innerText;
            const emoji = document.getElementById('emojiBox').innerText;

            if (name === "버튼을 눌러주세요" || name === "추천 메뉴 찾는 중...") {
                showToast("먼저 저녁 메뉴를 추천받아 보세요!");
                return;
            }

            const textToCopy = `[오늘 저녁 메뉴 추천] 오늘 저녁은 ${emoji} ${name} 어때요?`;
            navigator.clipboard.writeText(textToCopy).then(() => {
                showToast("결과가 클립보드에 복사되었습니다!");
            });
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2000);
        }
    </script>
</body>
</html>
